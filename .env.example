# Pixel Office configuration
# Copy this file to .env and adjust values as needed.

# HTTP server port
PORT=19000

# Ollama API URL (internal k8s service URL)
OLLAMA_API_URL=http://ollama.llm.svc.cluster.local:11434

# Ollama model for AI Director
OLLAMA_MODEL=llama3.2:1b

# Directory for runtime data (logs, cached config, agent messages, etc.)
# Can be absolute or relative to the app directory
PIXEL_DATA_DIR=./data

# Admin password for the Pixel dashboard login
DASHBOARD_PASSWORD=***
