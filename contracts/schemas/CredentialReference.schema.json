{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://github.com/bageera/pixel-startup/contracts/schemas/CredentialReference.schema.json",
 "title": "Pixel Startup CredentialReference contract",
 "type": "object",
 "properties": {
  "id": {
   "type": "string",
   "pattern": "^[A-Za-z0-9_.:@-]+$",
   "minLength": 4
  },
  "type": {
   "const": "CredentialReference"
  },
  "version": {
   "const": 1
  },
  "credential_id": {
   "type": "string",
   "minLength": 4
  },
  "provider": {
   "type": "string",
   "minLength": 1
  },
  "purpose": {
   "type": "string",
   "minLength": 1
  },
  "operational_scope": {
   "enum": [
    "company",
    "household",
    "shared",
    "employee"
   ]
  },
  "retrieval_allowed": {
   "type": "boolean"
  }
 },
 "required": [
  "id",
  "type",
  "version",
  "credential_id",
  "provider",
  "purpose",
  "operational_scope",
  "retrieval_allowed"
 ],
 "additionalProperties": false
}
